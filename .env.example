# Unipile (dashboard > API access). DSN looks like api8.unipile.com:13851
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=

# Notion internal integration token + database ids (printed by setup_notion.py)
NOTION_TOKEN=
NOTION_WATCHLIST_DB=
NOTION_POSTS_DB=
NOTION_ENGAGERS_DB=
NOTION_RUNS_DB=

# Optional overrides (defaults shown)
# MAX_POSTS_PER_ACCOUNT=50
# REFRESH_WINDOW_DAYS=7
# DELAY_MIN_S=3
# DELAY_MAX_S=8
# ENGAGER_WINDOW_DAYS=7
# MAX_REACTIONS_PER_POST=100
# MAX_COMMENTS_PER_POST=100
# ENGAGER_TIME_BUDGET_S=780

# Optional: skip engagers who are already People in Attio (read-only key, People: read)
ATTIO_API_KEY=

# Optional: push engagers that are not in Attio to a lemlist campaign (needs ATTIO_API_KEY too)
LEMLIST_API_KEY=
# LEMLIST_CAMPAIGN_NAME=LinkedIn engagers (watchlist)
