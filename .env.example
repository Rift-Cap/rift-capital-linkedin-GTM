# Unipile (dashboard > API access). DSN looks like api8.unipile.com:13851
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=

# Notion internal integration token + database ids (printed by setup_notion.py)
NOTION_TOKEN=
NOTION_WATCHLIST_DB=
NOTION_POSTS_DB=
NOTION_RUNS_DB=

# Optional overrides (defaults shown)
# MAX_POSTS_PER_ACCOUNT=50
# REFRESH_WINDOW_DAYS=7
# DELAY_MIN_S=3
# DELAY_MAX_S=8
