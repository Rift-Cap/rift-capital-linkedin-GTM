# Unipile (dashboard > API access). DSN looks like api8.unipile.com:13851
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=

# Notion internal integration token + database ids (printed by setup_notion.py)
NOTION_TOKEN=
NOTION_POSTS_DB=
NOTION_ENGAGERS_DB=
NOTION_SNAPSHOTS_DB=
NOTION_RUNS_DB=

# lemlist (Settings > Integrations > API) and target campaign id (camp_...)
LEMLIST_API_KEY=
LEMLIST_CAMPAIGN_ID=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Optional overrides (defaults shown)
# KEYWORDS=secondary market,continuation fund
# DATE_POSTED=past_week
# QUALIFY_MIN_SCORE=70
# REQUIRE_APPROVAL=true
# MAX_POSTS_PER_RUN=15
# PER_CATEGORY_LIMIT=40
